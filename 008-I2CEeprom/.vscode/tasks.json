{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Debug",
      "type": "shell",
      "command": "cmake --preset Debug && cmake --build --preset Debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Compile Release",
      "type": "shell",
      "command": "cmake --preset Release && cmake --build --preset Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    }
  ]
}
